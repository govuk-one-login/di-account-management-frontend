{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "home",
      "component": "home",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/lint.yaml",
          "path": "$.jobs.lint"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/dependency-review.yaml",
          "path": "$.jobs.dependency-review"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/sonarcloud.yaml",
          "path": "$.jobs.sonarcloud"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration"
            },
            {
              "name": "unit",
              "purpose": ["new feature", "regression"]
            }
          ],
          "file": ".github/workflows/local-tests-unit.yaml",
          "path": "$.jobs.local-tests-unit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "accessibility"
            },
            {
              "name": "integration",
              "purpose": ["regression"]
            }
          ],
          "file": ".github/workflows/local-tests-integration.yaml",
          "path": "$.jobs.local-tests-integration"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration"
            },
            {
              "name": "unit",
              "purpose": ["new feature", "regression"]
            }
          ],
          "file": ".github/workflows/on-merge-to-main.yaml",
          "path": "$.jobs.validate_application"
        },
        {
          "phase": "build",
          "provider": "Stack Orchestration Tool",
          "checks": [
            {
              "name": "accessibility"
            },
            {
              "name": "integration",
              "purpose": ["regression"]
            }
          ],
          "file": "integration-tests/Dockerfile"
        }
      ]
    }
  ]
}
