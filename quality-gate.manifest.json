{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.18.0/schemas/schema.json",
  "services": [
    {
      "product": "One-Login-Home",
      "component": "di-account-management-frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature",
                "regression"
              ]
            },
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/build-test-application.yml",
          "path": "$.jobs.build_test_application"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/detect-secrets.yaml",
          "path": "$.jobs.detect-secrets"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            },
            {
              "name": "accessibility"
            }
          ],
          "file": ".github/workflows/integration-tests.yml",
          "path": "$.jobs.end_to_end_tests"
        },
        {
          "phase": "build",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "new feature",
                "regression"
              ]
            },
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/on-merge-to-main.yml",
          "path": "$.jobs.validate_application"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/checkov.yml",
          "path": "$.jobs.checkov"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/sonarcloud.yml",
          "path": "$.jobs.sonarcloud"
        }
      ]
    }
  ]
}
