{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.14.0/schemas/schema.json",
  "services": [
    {
      "product": "One-Login-Home",
      "component": "di-account-management-frontend",
      "promotionType": "securePipelines",
      "automated": [
        {
          "checkTypes": [
            "unit",
            "new feature",
            "regression",
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/build-test-application.yml",
            "path": "$.jobs.build_test_application"
          }
        },
        {
          "checkTypes": [
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/detect-secrets.yaml",
            "path": "$.jobs.detect-secrets"
          }
        },
        {
          "checkTypes": [
            "integration",
            "accessibility",
            "regression"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/integration-tests.yml",
            "path": "$.jobs.end_to_end_tests"
          }
        },
        {
          "checkTypes": [
            "unit",
            "new feature",
            "regression",
            "code style and linting"
          ],
          "phase": "build",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/on-merge-to-main.yml",
            "path": "$.jobs.validate_application"
          }
        },
        {
          "checkTypes": [
            "code quality"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checkov.yml",
            "path": "$.jobs.checkov"
          }
        },
        {
          "checkTypes": [
            "code quality",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sonarcloud.yml",
            "path": "$.jobs.sonarcloud"
          }
        }
      ]
    }
  ]
}
